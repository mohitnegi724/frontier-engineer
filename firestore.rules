rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) {
   return request.auth != null && request.auth.uid == uid
    && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  match /users/{uid} {
   allow get: if owner(uid);
   allow list, delete: if false;
   function validProfile() {
    return owner(uid)
    && request.resource.data.keys().hasOnly(['uid','name','email','createdAt','updatedAt','lastLoginAt'])
    && request.resource.data.keys().hasAll(['uid','name','email','createdAt','updatedAt','lastLoginAt'])
    && request.resource.data.uid == uid
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.email is string && request.resource.data.email.size() <= 320
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
    && request.resource.data.createdAt is timestamp
    && request.resource.data.updatedAt == request.time
    && request.resource.data.lastLoginAt == request.time;
   }
   allow create: if validProfile() && request.resource.data.createdAt == request.time;
   allow update: if validProfile() && request.resource.data.createdAt == resource.data.createdAt;
   match /workspace/{recordId} {
    function validData() {
     let d = request.resource.data.data;
     return (recordId == 'settings' && d.keys().hasOnly(['version','lastLesson']) && d.version == 1
       && (d.lastLesson == null || (d.lastLesson is string && d.lastLesson.size() <= 100)))
      || (recordId.matches('lesson-[a-z0-9-]{1,100}') && d.keys().hasOnly(['read','watched','practised','notes','updatedAt'])
       && d.read is bool && d.watched is bool && d.practised is bool
       && d.notes is string && d.notes.size() <= 50000
       && (d.updatedAt == null || (d.updatedAt is string && d.updatedAt.size() <= 40)))
      || (recordId.matches('draft-[a-zA-Z0-9_-]{1,100}') && d.keys().hasOnly(['code']) && d.code is string && d.code.size() <= 150000)
      || (recordId.matches('activity-[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.keys().hasOnly(['count']) && d.count is int && d.count >= 0 && d.count <= 1000)
      || (recordId.matches('capstone-(search|retrieval|workspace)') && d.keys().hasOnly(['complete']) && d.complete is bool);
    }
    allow read: if owner(uid);
    allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['data','updatedAt'])
     && request.resource.data.data is map
     && request.resource.data.updatedAt == request.time
     && validData();
    allow delete: if false;
   }
  }
 }
}
